# Include the objects.mk file first to define $(SRC_MAIN) and $(OBJ_MODEL)
include sources.mk

SRC_MAIN = ED2/ED/src/driver/edmain.F90

FC=@FC@
CC=@CC@
AR=@AR@
ARFLAGS=@ARFLAGS@
AROUT=@AROUT@

# Define the main program and static library variables
MAIN = @MAIN@
STATICLIB = libed2.a
PATCHSTAMP = ED2/.patched-v220-windows

# Executables
MD = mkdir -p
CP = cp

# Compiler and linker flags
CFLAGS = @CFLAGS@
FCFLAGS = @FCFLAGS@
LDFLAGS = @LIBS@

# Define source files for the main program
OBJ_MAIN = $(SRC_MAIN:.F90=.o)

# Replace source files extension with object extension
OBJECTS_1 = $(SOURCES:.F90=.o)
OBJECTS_2 = $(OBJECTS_1:.f90=.o)
OBJECTS = $(OBJECTS_2:.c=.o)

INSTALLDIR = ../inst
TOOLPATH = @TOOLPATH@
TOOL_ENV = @TOOL_ENV@
TOOL_LIB = @TOOL_LIB@
TOOL_INCLUDE = @TOOL_INCLUDE@
TOOL_DLL_DIR = @TOOL_DLL_DIR@

ifneq ($(strip $(TOOLPATH)),)
export PATH := $(TOOLPATH):$(PATH)
endif

ifneq ($(strip $(TOOL_LIB)),)
export LIB := $(TOOL_LIB);$(LIB)
endif

ifneq ($(strip $(TOOL_INCLUDE)),)
export INCLUDE := $(TOOL_INCLUDE);$(INCLUDE)
endif

# Additional Fortran clean files
CLEANFILES = *.mod $(OBJECTS) $(MAIN) $(STATICLIB) $(PATCHSTAMP) $(INSTALLDIR)/bin/$(MAIN)

all: $(MAIN)

# Include the dependency makefile
include dependency.mk

$(MAIN): $(OBJ_MAIN) $(STATICLIB)
	$(TOOL_ENV) $(FC) $(FCFLAGS) -o $@ $^ $(LDFLAGS); \
	$(MD) $(INSTALLDIR)/bin; \
	$(CP) $(MAIN) $(INSTALLDIR)/bin/; \
	if test -n "$(TOOL_DLL_DIR)" -a -d "$(TOOL_DLL_DIR)"; then \
		for lib in "$(TOOL_DLL_DIR)"/*.dll "$(TOOL_DLL_DIR)"/*.so "$(TOOL_DLL_DIR)"/*.so.*; do \
			test -f "$$lib" && $(CP) "$$lib" $(INSTALLDIR)/bin/; \
		done; \
	fi; \
	true

$(PATCHSTAMP):
	cd .. && sh tools/patch_ed2_v220_windows.sh src/ED2
	touch $(PATCHSTAMP)

$(OBJ_MAIN) $(OBJECTS): | $(PATCHSTAMP)

$(STATICLIB): $(OBJECTS)
	$(AR) $(ARFLAGS) $(AROUT)$@ $^

%.o: %.F90
	$(FC) -c $(FCFLAGS) -o $@ $<

%.o: %.f90
	$(FC) -c $(FCFLAGS) -o $@ $<

%.o: %.c
	$(CC) -c $(CFLAGS) -o $@ $<

clean:
	$(RM) $(CLEANFILES)

.PHONY: all clean
