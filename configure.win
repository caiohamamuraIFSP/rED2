mkdir src/build
pushd src/build
cmake .. -G "MinGW Makefiles" -DHDF5_GENERATE_HEADERS:BOOL=true -DHDF5_DISABLE_COMPILER_WARNINGS:BOOL=true -DBUILD_SHARED_LIBS:BOOL=false -DCMAKE_BUILD_TYPE=Release -DHDF5_BUILD_FORTRAN:BOOL=true -DHDF5_BUILD_CPP_LIB:BOOL=false -DHDF5_BUILD_TOOLS:BOOL=false -DBUILD_TESTING:BOOL=false -DHDF5_BUILD_EXAMPLES:BOOL=false -DBUILD_STATIC_EXECS:BOOL=OFF -DCMAKE_Fortran_COMPILER=gfortran
cmake --build . -j10
